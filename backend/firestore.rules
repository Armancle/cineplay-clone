rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog metadata cache (movies, games, people, genres, providers)
    // Readable publicly; client writes disabled to prevent unauthorized modifications
    match /movies/{movieId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /people/{personId} {
      allow read: if true;
      allow write: if false;
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if false;
    }

    match /providers/{providerId} {
      allow read: if true;
      allow write: if false;
    }

    // Protected User Collections (Favorites, History, Preferences)
    // Only authenticated users can access and manage their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{userDoc=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
